datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  trips        Trip[]
  favourites   Favourite[]
}

model Trip {
  id                       String      @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String      @db.ObjectId
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin                   String
  destination              String
  startDate                DateTime
  endDate                  DateTime
  numberOfTravellers       Int
  budget                   Float
  travelStyle              String      // Solo, Couple, Friends, Family
  transportPreference      String      // Flight, Train, Bus, Car, Any
  interests                String      // Stringified JSON Array
  estimatedTransportCost   Float
  estimatedHotelCost       Float
  estimatedFoodCost       Float
  estimatedLocalTravelCost Float
  estimatedActivitiesCost  Float
  estimatedMiscCost        Float
  estimatedTotalCost       Float
  weatherData              String      // Stringified JSON Object
  packingList              String      // Stringified JSON Object
  stayPreference           String?     // Hostel, Hotel, Resort, Homestay
  expenses                 String?     // Stringified JSON Array of expenses [{id, description, amount, category, date}]
  itinerary                Itinerary?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
}

model Destination {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String   @unique
  state              String
  country            String
  description        String
  image              String
  popularActivities  String   // Stringified JSON Array
  bestTime           String   // e.g. "October to March"
  typicalSeason      String   // e.g. "Winter", "Summer", "Monsoon"
  typicalWeather     String   // Stringified JSON Object
  typicalCosts       String   // Stringified JSON Object
  popularAttractions String   // Stringified JSON Array
  lat                Float    @default(0.0)
  lon                Float    @default(0.0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Itinerary {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  tripId    String         @unique @db.ObjectId
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  totalCost Float
  days      ItineraryDay[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ItineraryDay {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  itineraryId   String    @db.ObjectId
  itinerary     Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber     Int
  morning       String
  afternoon     String
  evening       String
  estimatedCost Float
}

model Favourite {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationName String
  createdAt       DateTime @default(now())

  @@unique([userId, destinationName])
}
