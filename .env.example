# Database Connection URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aitravelplanner?schema=public"

# JWT Secret for authentication
JWT_SECRET="your_jwt_secret_key_here_at_least_32_chars"

# External API Keys (Leave blank or insert actual keys to activate live features)
# Gemini API Key for AI Travel Planner (https://aistudio.google.com/)
AI_API_KEY=""

# OpenWeatherMap API Key for weather forecasts (https://openweathermap.org/)
WEATHER_API_KEY=""

# Map API Key (optional - OpenStreetMap is used by default without keys)
MAP_API_KEY=""

# Server Configuration
PORT=5000
NODE_ENV="development"
